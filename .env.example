# ─────────────────────────────────────────────────────────────────────────────
# spa-capelli-web · .env.example
# Copy this file to .env.local for local development
# ─────────────────────────────────────────────────────────────────────────────

# ── TinaCMS (local mode) ──────────────────────────────────────────────────────
# In local mode these can be empty — TinaCMS uses the local filesystem.
# For Tina Cloud (online editing), set real values here AND as GitHub secrets:
#   TINA_CLIENT_ID  → Settings → Secrets → Actions
#   TINA_TOKEN      → Settings → Secrets → Actions

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
