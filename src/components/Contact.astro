---
/**
 * src/components/Contact.astro
 */
import { siteConfig, schedule, waLink } from '../data/index';
---

<section class="contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-grid">

      <!-- Info col -->
      <div class="reveal">
        <span class="section-label">Escríbenos</span>
        <h2 class="section-title" id="contact-title">
          Agenda tu <em>hora</em>
        </h2>
        <div class="section-line"></div>

        <address class="contact-items">
          <div class="contact-item">
            <div class="contact-icon" aria-hidden="true">📍</div>
            <div>
              <p class="contact-label">Dirección</p>
              <p class="contact-value">
                {siteConfig.address}<br />{siteConfig.city}
              </p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon" aria-hidden="true">📱</div>
            <div>
              <p class="contact-label">WhatsApp</p>
              <p class="contact-value">
                <a
                  href={`https://wa.me/${siteConfig.phone}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Llamar o escribir al ${siteConfig.phone}`}
                >
                  +56 9 7483 5260
                </a>
              </p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon" aria-hidden="true">📸</div>
            <div>
              <p class="contact-label">Instagram</p>
              <p class="contact-value">
                <a
                  href={`https://instagram.com/${siteConfig.instagram}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  @{siteConfig.instagram}
                </a>
              </p>
            </div>
          </div>
        </address>

        <a
          href={waLink('Hola! quiero reservar una hora en Spa Capelli')}
          class="btn btn-wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          💬 &nbsp; Reservar por WhatsApp
        </a>
      </div>

      <!-- Schedule col -->
      <div class="reveal">
        <div class="open-badge" aria-live="polite">
          <span class="badge-dot" aria-hidden="true"></span>
          Abierto ahora
        </div>

        <div class="schedule-card">
          <h3 class="schedule-title">🕐 Horario de atención</h3>
          <dl class="schedule-list">
            {schedule.map((d) => (
              <div class="schedule-row" data-closed={d.closed ? 'true' : undefined}>
                <dt class="schedule-day">{d.day}</dt>
                <dd class="schedule-hours">{d.hours}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-section { background: var(--c-cream-2); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-items { font-style: normal; }

  .contact-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(211, 184, 99, 0.2);
  }
  .contact-item:last-child { border-bottom: none; }

  .contact-icon {
    width: 36px; height: 36px;
    border: 1.5px solid var(--c-gold-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 0.9rem;
    background: var(--c-cream);
  }

  .contact-label {
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-gold-dark);
    margin-bottom: 0.3rem;
  }
  .contact-value {
    font-size: 0.88rem;
    color: var(--c-text);
    line-height: 1.6;
  }
  .contact-value a {
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .contact-value a:hover { color: var(--c-gold-dark); }

  /* Open badge */
  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #edf7ed;
    border: 1px solid #b8ddb8;
    padding: 0.3rem 0.75rem;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #3a7a3a;
    margin-bottom: 1.5rem;
  }
  .badge-dot {
    width: 5px; height: 5px;
    background: #4caf50;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  /* Schedule */
  .schedule-card {
    background: var(--c-cream);
    border: var(--border-gold);
    padding: 2rem;
  }
  .schedule-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--c-black);
    margin-bottom: 1.5rem;
  }

  .schedule-list { display: flex; flex-direction: column; }

  .schedule-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(211, 184, 99, 0.12);
    font-size: 0.8rem;
  }
  .schedule-row:last-child { border-bottom: none; }
  .schedule-row[data-closed] { opacity: 0.4; }

  .schedule-day { color: var(--c-text-soft); }
  .schedule-hours { color: var(--c-black); font-weight: 500; }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
