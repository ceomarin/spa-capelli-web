---
/**
 * src/components/Hero.astro
 */
import { siteConfig, quickServices, waLink, assetUrl } from '../data/index';
const { hero } = siteConfig;
---

<section class="hero" id="inicio" aria-label="Bienvenida">
  <div class="hero-left">
    <p class="hero-eyebrow">{hero.eyebrow}</p>

    <h1 class="hero-title">
      {hero.titleLine1}
      <br />
      <em>{hero.titleHighlight}</em>
    </h1>

    <p class="hero-sub">{hero.subtitle}</p>
    <div class="hero-divider" role="presentation"></div>
    <p class="hero-desc">{hero.description}</p>

    <div class="hero-btns">
      <a href={waLink()} class="btn btn-dark" target="_blank" rel="noopener noreferrer">
        Reservar hora
      </a>
      <a href="#servicios" class="btn btn-ghost">Ver servicios</a>
    </div>

    <p class="hero-horario" aria-label="Horario">
      Lun – Sáb &nbsp;·&nbsp; 11:00 – 20:00
    </p>
  </div>

  <div class="hero-right" aria-hidden="true">
    <img
      src={assetUrl(hero.image)}
      alt={hero.imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="800"
      height="900"
    />
  </div>
</section>

<!-- Quick services bar -->
<div class="services-bar" aria-label="Servicios disponibles" role="list">
  <div class="services-bar-inner">
    {quickServices.map((item) => (
      <div class="sr-item" role="listitem">
        <span class="sr-icon" aria-hidden="true">{item.icon}</span>
        <span class="sr-label">{item.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding-top: var(--nav-height);
    overflow: hidden;
    background: var(--c-cream);
  }

  .hero-left {
    padding: 4rem 3rem 4rem 5rem;
  }

  .hero-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-gold-dark);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: fadeUp 0.7s 0.2s forwards;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 30px;
    height: 1px;
    background: var(--c-gold);
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.05;
    color: var(--c-black);
    margin-bottom: 0.4rem;
    opacity: 0;
    animation: fadeUp 0.7s 0.35s forwards;
  }
  .hero-title em {
    font-style: italic;
    color: var(--c-gold-dark);
  }

  .hero-sub {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--c-text-soft);
    font-weight: 400;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.7s 0.45s forwards;
  }

  .hero-divider {
    width: 50px;
    height: 2px;
    background: linear-gradient(to right, var(--c-gold), var(--c-gold-cream));
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.7s 0.5s forwards;
  }

  .hero-desc {
    font-size: 0.88rem;
    color: var(--c-text-soft);
    line-height: 1.9;
    max-width: 380px;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.7s 0.6s forwards;
  }

  .hero-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.7s 0.75s forwards;
  }

  .hero-horario {
    margin-top: 2.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-gold-dark);
    opacity: 0;
    animation: fadeUp 0.7s 0.9s forwards;
  }

  /* Hero image */
  .hero-right {
    height: 100vh;
    position: relative;
    overflow: hidden;
  }
  .hero-right img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-right::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--c-cream) 0%, transparent 25%);
    pointer-events: none;
  }

  /* ── Services bar ─────────────────────────────────────────────────────────── */
  .services-bar {
    background: var(--c-cream-2);
    padding: 1.5rem 2rem;
    border-top: 1px solid rgba(211, 184, 99, 0.25);
    border-bottom: 1px solid rgba(211, 184, 99, 0.25);
  }
  .services-bar-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .services-bar-inner::-webkit-scrollbar { display: none; }

  .sr-item {
    flex: 1;
    min-width: 140px;
    text-align: center;
    padding: 0.75rem 1rem;
    border-right: 1px solid rgba(211, 184, 99, 0.25);
  }
  .sr-item:last-child { border-right: none; }
  .sr-icon { font-size: 1.1rem; margin-bottom: 0.3rem; display: block; }
  .sr-label {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-soft);
  }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-left { padding: 2rem 1.25rem 2.5rem; }
    .hero-right { height: 60vw; }
    .hero-btns { flex-direction: column; gap: 0.75rem; }
    .hero-btns .btn { width: 100%; text-align: center; }
    .sr-item { flex-shrink: 0; }
  }
</style>
