---
/**
 * src/components/PrivacyModal.astro
 * Accessible modal dialog for privacy policy
 */
import { privacy, siteConfig } from '../data/index';
---

<div
  id="modal-privacy"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="modal-box">
    <button
      id="close-privacy"
      class="modal-close"
      aria-label="Cerrar política de privacidad"
    >
      ✕
    </button>

    <p class="modal-eyebrow">{siteConfig.siteName} Centro de Estética</p>
    <h2 class="modal-title" id="modal-title">
      Política de <em>Privacidad</em>
    </h2>
    <div class="modal-line"></div>

    <div class="modal-body">
      <p class="last-update">
        <strong>Última actualización:</strong> {privacy.lastUpdate}
      </p>

      {privacy.sections.map((section) => (
        <div class="privacy-section">
          <h3>{section.title}</h3>
          <p set:html={section.content} />
          {section.listItems?.length > 0 && (
            <ul>
              {section.listItems.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      ))}

      <div class="privacy-note">
        ¿Tienes preguntas sobre esta política? Escríbenos directamente a través
        de WhatsApp y te respondemos a la brevedad.
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(26, 22, 18, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    /* Hidden by default */
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }
  .modal-backdrop.open {
    visibility: visible;
    opacity: 1;
  }

  .modal-box {
    background: var(--c-cream);
    max-width: 680px;
    width: 100%;
    margin: 2rem auto;
    padding: 2.5rem;
    position: relative;
    border: var(--border-gold);
    transform: translateY(16px);
    transition: transform var(--transition-base);
  }
  .modal-backdrop.open .modal-box {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 1rem; right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    color: var(--c-text-soft);
    line-height: 1;
    transition: color var(--transition-fast);
  }
  .modal-close:hover { color: var(--c-black); }

  .modal-eyebrow {
    font-size: 0.58rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--c-gold-dark);
    margin-bottom: 0.5rem;
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--c-black);
    margin-bottom: 0.5rem;
  }
  .modal-title em { font-style: italic; color: var(--c-gold-dark); }

  .modal-line {
    width: 40px; height: 2px;
    background: var(--c-gold);
    margin: 1rem 0 1.5rem;
  }

  .modal-body {
    font-size: 0.82rem;
    color: var(--c-text-soft);
    line-height: 1.9;
    max-height: 60vh;
    overflow-y: auto;
    padding-right: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-gold-cream) transparent;
  }

  .last-update { margin-bottom: 1rem; }
  .last-update strong { color: var(--c-black); }

  .privacy-section { margin-bottom: 1.5rem; }
  .privacy-section h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--c-black);
    margin: 1.5rem 0 0.5rem;
  }
  .privacy-section p { margin-bottom: 0.5rem; }
  .privacy-section ul {
    margin: 0.5rem 0 1rem 1.25rem;
  }
  .privacy-section li { margin-bottom: 0.25rem; }

  .privacy-note {
    background: var(--c-cream-2);
    border: var(--border-gold);
    padding: 1rem 1.25rem;
    font-size: 0.78rem;
    color: var(--c-text-soft);
  }
</style>

<script>
  const modal   = document.getElementById('modal-privacy');
  const openBtn = document.getElementById('open-privacy');
  const closeBtn = document.getElementById('close-privacy');

  function openModal() {
    modal?.classList.add('open');
    modal?.setAttribute('aria-hidden', 'false');
    closeBtn?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('open');
    modal?.setAttribute('aria-hidden', 'true');
    openBtn?.focus();
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
  });
</script>
