---
/**
 * src/components/Testimonials.astro
 */
import { testimonials } from '../data/index';
---

<section class="testimonials-section" aria-labelledby="testi-title">
  <div class="testi-inner">
    <div class="reveal">
      <span class="section-label">Clientas felices</span>
      <h2 class="section-title" id="testi-title">
        Lo que dicen de <em>nosotras</em>
      </h2>
      <div class="section-line"></div>
    </div>

    <div class="testi-grid" role="list">
      {testimonials.map((t) => (
        <article class="testi-card reveal" role="listitem">
          <div class="testi-stars" aria-label="5 estrellas" role="img">★★★★★</div>
          <p class="testi-text">"{t.text}"</p>
          <div class="testi-author">
            <div class="testi-avatar" aria-hidden="true">{t.initial}</div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-service">{t.service}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section { background: var(--c-cream-2); }

  .testi-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-3xl) var(--space-xl);
  }

  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .testi-card {
    background: var(--c-cream);
    border: var(--border-gold);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition-base);
  }
  .testi-card:hover { border-color: var(--c-gold); }

  .testi-stars {
    color: var(--c-gold);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .testi-text {
    font-size: 0.82rem;
    color: var(--c-text-soft);
    line-height: 1.9;
    flex: 1;
    font-style: italic;
  }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
  }

  .testi-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--c-gold-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--c-gold-dark);
    flex-shrink: 0;
  }

  .testi-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--c-black);
  }
  .testi-service {
    font-size: 0.68rem;
    color: var(--c-gold-dark);
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .testi-inner { padding: 3.5rem 1.25rem; }
    .testi-grid { grid-template-columns: 1fr; }
  }
</style>
