---
/**
 * src/components/Treatments.astro
 */
import { treatments, assetUrl } from '../data/index';
---

<section class="treatments-section" id="tratamientos" aria-labelledby="treatments-title">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Protocolos especializados</span>
      <h2 class="section-title" id="treatments-title">
        Nuestros <em>tratamientos</em>
      </h2>
      <div class="section-line"></div>
    </div>

    <div class="treatment-banner reveal" aria-hidden="true">
      <img
        src={assetUrl(treatments.bannerImage)}
        alt={treatments.bannerAlt}
        loading="lazy"
        decoding="async"
        width="1100"
        height="420"
      />
    </div>

    <div class="treatment-grid" role="list">
      {treatments.categories.map((cat) => (
        <article class="treatment-card reveal" role="listitem">
          <div class="tto-icon" aria-hidden="true">{cat.icon}</div>
          <h3 class="tto-name">{cat.name}</h3>
          <ul class="tto-items" aria-label={`Servicios de ${cat.name}`}>
            {cat.items.map((item) => (
              <li>
                <span class="tto-item-name">{item.name}</span>
                <span class="tto-price">{item.price}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .treatments-section { background: var(--c-cream); }

  .treatment-banner {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    margin-bottom: 3rem;
    border: var(--border-gold);
  }
  .treatment-banner img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center 35%;
  }

  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .treatment-card {
    background: var(--c-cream-2);
    border: var(--border-gold);
    padding: 2rem 1.75rem;
    transition: border-color var(--transition-base), background var(--transition-base);
  }
  .treatment-card:hover {
    border-color: var(--c-gold);
    background: #faf6ec;
  }

  .tto-icon {
    width: 38px; height: 38px;
    border: 1.5px solid var(--c-gold-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    font-size: 1rem;
    color: var(--c-gold-dark);
  }
  .tto-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--c-black);
    margin-bottom: 0.5rem;
  }

  .tto-items {
    list-style: none;
    margin-top: 0.75rem;
  }
  .tto-items li {
    font-size: 0.75rem;
    color: var(--c-text-soft);
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(211, 184, 99, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tto-items li:last-child { border-bottom: none; }

  .tto-price {
    color: var(--c-gold-dark);
    font-size: 0.77rem;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .treatment-grid { grid-template-columns: 1fr; }
    .treatment-banner img { height: 240px; }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    .treatment-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
