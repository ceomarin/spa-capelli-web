---
/**
 * src/components/WhyUs.astro
 */
import { whyUs } from '../data/index';
---

<section class="why-us" aria-labelledby="why-title">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Nuestra diferencia</span>
      <h2 class="section-title" id="why-title">
        ¿Por qué <em>elegirnos?</em>
      </h2>
      <div class="section-line"></div>
    </div>

    <div class="why-grid" role="list">
      {whyUs.map((card) => (
        <div class="why-card reveal" role="listitem">
          <div class="why-icon" aria-hidden="true">{card.icon}</div>
          <h4 class="why-title-card">{card.title}</h4>
          <p>{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us { background: var(--c-cream-3); }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .why-card {
    background: var(--c-cream);
    border: var(--border-gold);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }
  .why-card:hover {
    border-color: var(--c-gold);
    transform: translateY(-3px);
  }

  .why-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    display: block;
  }
  .why-title-card {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--c-black);
    margin-bottom: 0.75rem;
  }
  p {
    font-size: 0.8rem;
    color: var(--c-text-soft);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
